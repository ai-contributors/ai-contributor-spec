#!/usr/bin/env sh
# Pre-commit hook — runs Prettier, ESLint, and markdownlint on staged files.
# Closes the AI Contributor `Pre-Commit` (AIC-precommit-meaningful-checks) gap.
#
# Tooling lives under tools/node_modules — lint-staged runs it from there.
# Bypass requires explicit `--no-verify`, which AGENTS.md forbids.

cd "$(git rev-parse --show-toplevel)"

if [ ! -x tools/node_modules/.bin/lint-staged ]; then
  echo "pre-commit: tools/node_modules not found — run 'npm ci --prefix tools' first." >&2
  exit 1
fi

tools/node_modules/.bin/lint-staged
